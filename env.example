# Google Cloud / Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Agent model
MODEL=gemini-2.5-flash

# PostgreSQL — replace with your Cloud SQL or local DB URL
DATABASE_URL=postgresql://user:password@localhost:5432/solopitch

# Tavily Search API (free tier available at tavily.com)
TAVILY_API_KEY=your-tavily-api-key

# Notes directory — local folder or mount point acting as Notes MCP
NOTES_DIR=./notes
